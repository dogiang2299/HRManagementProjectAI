  read_at       DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([receiver_id, receiver_role])
  @@index([type])
  @@index([is_read])
  @@index([created_at])
}

model CandidateJobRecommendation {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidate_id           String            @db.Uuid
  recruitment_infor_id   String            @db.Uuid
